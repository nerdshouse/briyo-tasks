# 11za WhatsApp API (required for task-assignment & daily reminders)
VITE_11ZA_API_URL=https://app.11za.in/apis/template/sendTemplate
VITE_11ZA_ORIGIN_WEBSITE=
VITE_11ZA_AUTH_TOKEN=your_11za_auth_token_here

# Optional: template names as created in 11za dashboard
