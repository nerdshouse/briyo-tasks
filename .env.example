# Firebase (required – no defaults in production)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# 11za WhatsApp sending happens server-side now (Cloud Functions), so the API URL/
# origin/auth token are no longer needed here — see functions/.env.example instead.
